<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Architecture\Identity\PermissionRegistry.json" LogicalName="Alveara.Api.PermissionRegistry.json" />
    <!-- ALV-N026 S4: the reviewed PDF engine pins and the approved template versions travel inside the assembly, so they cannot be changed on the server.
         Each template file is listed explicitly ("Alveara.Api.PdfTemplates.<id>.<version>.<file>"): a new template version is a reviewed addition here and in templates.manifest.json. -->
    <EmbeddedResource Include="..\..\build\pdf-engine.manifest.json" LogicalName="Alveara.Api.pdf-engine.manifest.json" />
    <EmbeddedResource Include="Pdf\Templates\templates.manifest.json" LogicalName="Alveara.Api.PdfTemplates.templates.manifest.json" />
    <EmbeddedResource Include="Pdf\Templates\selftest\v1\main.typ" LogicalName="Alveara.Api.PdfTemplates.selftest.v1.main.typ" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
    <!-- ALV-N019 R03 (PD-26 = update): pins the transitive Pkcs (via Microsoft.Data.SqlClient) to the first version fixed for GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <!--
    N002-R03-01: `dotnet publish` must produce a self-contained server output that includes the
    built client, not just the API. Without this target, Program.cs's static-file serving only
    ever worked against the repository's own working tree (where a developer had separately run
    `npm run build`), never against the actual deployable publish output.
  -->
  <PropertyGroup>
    <ClientProjectDir>$(MSBuildThisFileDirectory)..\alveara-client\</ClientProjectDir>
  </PropertyGroup>

  <Target Name="BuildClientForPublish" BeforeTargets="Publish">
    <Exec Command="npm ci" WorkingDirectory="$(ClientProjectDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientProjectDir)" />
  </Target>

  <Target Name="CopyClientBuildToPublishOutput" AfterTargets="Publish" DependsOnTargets="BuildClientForPublish">
    <ItemGroup>
      <ClientBuildFiles Include="$(ClientProjectDir)dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientBuildFiles)" DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
