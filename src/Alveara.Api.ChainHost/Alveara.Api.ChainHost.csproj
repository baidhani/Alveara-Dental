<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ALV-N019 R02 (review correction 01, decisions O-1 and PD-32): the accumulated chain's own host. It runs the UNCHANGED production application (Alveara.Api, Program.cs untouched)
    through WebApplicationFactory on a real Kestrel port and swaps exactly one registration, IPracticeClock, for an injected test clock. The production executable never references this project.
    The Mvc.Testing version is the one the test project already pins; nothing is upgraded.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RootNamespace>Alveara.Api.ChainHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alveara.Api\Alveara.Api.csproj" />
  </ItemGroup>

</Project>
