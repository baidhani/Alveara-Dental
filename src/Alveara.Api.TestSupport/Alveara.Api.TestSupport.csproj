<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ALV-N030 (brief section 17, review BRIEFING-R07): the test-only account-fixture route. Referenced ONLY by Alveara.Api.ChainHost and Alveara.Api.Tests
    (guard G2 scans every project file). The product executable never references it, so it cannot map the route (G1, G3).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Alveara.Api.TestSupport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alveara.Api\Alveara.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Alveara.Api.Tests" />
  </ItemGroup>

</Project>
