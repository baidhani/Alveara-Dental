                  WHERE [t3].[ItemId] = [t].[Id] AND [t3].[RecordedAtUtc] &lt; @end) THEN N'Unscheduled'&#xD;
              ELSE (&#xD;
                  SELECT TOP(1) [t4].[Scheduling]&#xD;
