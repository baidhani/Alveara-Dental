      SELECT [s].[PlanItemId1] AS [PlanItemId], [s].[ProcedureCode1] AS [ProcedureCode], [s].[Line], COUNT(*) AS [Entries], COALESCE(SUM([s].[Amount]), 0.0) AS [Amount]&#xD;
      FROM (&#xD;
          SELECT [b].[Amount], COALESCE([b].[PlanItemId], [b0].[PlanItemId]) AS [PlanItemId1], COALESCE([b].[ProcedureCode], [b0].[ProcedureCode]) AS [ProcedureCode1], CASE&#xD;
              WHEN [b].[Kind] = N'Charge' THEN N'Charges'&#xD;
              WHEN [b].[Kind] = N'Payment' THEN N'Payments'&#xD;
              WHEN [b].[Kind] = N'Refund' THEN N'Refunds'&#xD;
              WHEN [b].[Kind] = N'Adjustment' THEN N'Adjustments'&#xD;
              WHEN [b].[Kind] = N'Reversal' THEN CASE&#xD;
                  WHEN [b0].[Kind] = N'Charge' THEN N'ChargeReversals'&#xD;
                  WHEN [b0].[Kind] = N'Payment' THEN N'PaymentReversals'&#xD;
                  WHEN [b0].[Kind] = N'Refund' THEN N'RefundReversals'&#xD;
                  WHEN [b0].[Kind] = N'Adjustment' THEN N'AdjustmentReversals'&#xD;
                  ELSE N'Unclassified'&#xD;
              END&#xD;
              ELSE N'Unclassified'&#xD;
          END AS [Line]&#xD;
          FROM [BillingEntries] AS [b]&#xD;
          LEFT JOIN [BillingEntries] AS [b0] ON [b].[ReversesEntryId] = [b0].[Id]&#xD;
          WHERE [b].[RecordedAtUtc] &gt;= @start AND [b].[RecordedAtUtc] &lt; @end AND (CASE&#xD;
              WHEN [b].[Kind] = N'Charge' THEN N'Charges'&#xD;
              WHEN [b].[Kind] = N'Payment' THEN N'Payments'&#xD;
