                  WHERE [t5].[ItemId] = [t].[Id] AND [t5].[RecordedAtUtc] &lt; @end) THEN N'NotStarted'&#xD;
              ELSE (&#xD;
                  SELECT TOP(1) [t6].[Completion]&#xD;
                  FROM [TreatmentPlanItemStates] AS [t6]&#xD;
                  WHERE [t6].[ItemId] = [t].[Id] AND [t6].[RecordedAtUtc] &lt; @end&#xD;
                  ORDER BY [t6].[Sequence] DESC)&#xD;
          END AS [Completion]&#xD;
          FROM [TreatmentPlanItems] AS [t]&#xD;
          INNER JOIN [TreatmentPlans] AS [t0] ON [t].[PlanId] = [t0].[Id]&#xD;
          WHERE [t0].[CreatedAtUtc] &gt;= @start AND [t0].[CreatedAtUtc] &lt; @end AND [t].[CreatedAtUtc] &lt; @end&#xD;
      ) AS [s]&#xD;
