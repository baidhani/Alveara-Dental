      SELECT [s].[Key] AS [Line], COUNT(*) AS [Entries], COALESCE(SUM([s].[Amount]), 0.0) AS [Amount]&#xD;
      FROM (&#xD;
          SELECT [b].[Amount], CASE&#xD;
